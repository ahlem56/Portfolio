---
import { Image } from "astro:assets";
import Avatar_250 from "../Avatar_250.webp";
import AhlemAvatar from "../assets/SVGs/ahlem (1).png";  // Updated to your image path
import { SectionTitle } from "./UI";
---

<section id="about" class="w-full min-h-screen px-6 py-4 pt-14 bg-background">
    <SectionTitle
        title="About Me"
        color="primary"
        className="h-screen flex flex-col justify-center"
    >
        <div class="flex_center flex-col lg:flex-row w-full h-full py-10 gap-8">
           <Image
    src={AhlemAvatar}  
    alt="About_Avatar"
    class="Fade_Up rounded-full scale-x-[-1] lg:mx-14"
    width={225}
    height={225}
    loading="lazy"
/>


            <div
                class="Fade_Up w-full md:w-[80%] lg:w-[60%] flex justify-center items-start flex-col gap-4 lg:border-l border-primary py-8 lg:pl-10"
            >
                <h2 class="Fade_Up text-[1.5em] font-bold">Hey there! 👋🏻</h2>
                <p class="Fade_Up text-justify">
                   I'm Ahlem, a third-year computer science student with a deep passion for web development and AI.
                    Currently pursuing my engineering degree in Computer science.
                </p>
                <p class="Fade_Up text-justify">
                    I specialize in full-stack development and have worked on various projects involving web platforms, mobile apps, and intelligent systems using machine learning and AI.
                    I’m passionate about creating efficient and scalable applications and constantly exploring new tools to stay ahead in the field.
                </p>
                 <p class="Fade_Up text-justify">
                    With hands-on experience in technologies such as Angular, Spring Boot, Python, React, and AI, I’m eager to take on challenging projects and collaborate to build impactful solutions.
                </p>
                <p class="Fade_Up text-justify">
                    Let's connect! I’m always excited to collaborate on innovative tech projects and bring ideas to life.
                </p>
            </div>
        </div>

